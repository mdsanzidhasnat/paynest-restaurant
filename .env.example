# Backend-only configuration. Vite never reads these values (no VITE_* secrets).
# Outside production, an unset JWT_SECRET generates a random per-process secret;
# sessions then reset on restart. Production requires at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
DB_PATH=./data/restaurant.db
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Backend-only QR signing secret; production requires 32+ characters.
QR_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Printed QR codes stay valid for this many seconds (default: one year).
QR_TOKEN_TTL_SECONDS=31536000
# Cashier discounts are clamped to this percentage of the subtotal.
MAX_CASHIER_DISCOUNT_PERCENT=10

# Demo seeding (placeholders only - never commit real credentials).
# Set to true only for a local demo. When true, seeding runs only if the users
# table is empty; missing *_PASSWORD values generate a random password that is
# printed once in the startup log (hashes are never logged).
SEED_DEMO_DATA=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-demo-admin-password
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=replace-with-demo-manager-password
WAITER_EMAIL=waiter@example.com
WAITER_PASSWORD=replace-with-demo-waiter-password
KITCHEN_EMAIL=kitchen@example.com
KITCHEN_PASSWORD=replace-with-demo-kitchen-password
CASHIER_EMAIL=cashier@example.com
CASHIER_PASSWORD=replace-with-demo-cashier-password
